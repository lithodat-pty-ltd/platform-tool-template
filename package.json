{
  "name": "platform-tool-template",
  "version": "0.9.0",
  "private": true,
  "description": "Template for a platform tool. The module owns its interface and receives a fixed set of host parameters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.5"
  }
}
